{
  "name": "sanskrit-lookup-app",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:only": "electron .",
    "electron:preview": "set ELECTRON_IS_PACKAGED=1&& electron .",
    "api:start": "python logic_handler/api_server.py --port 5199",
    "build:api": "C:\\Users\\hjiis\\miniconda3\\envs\\sanskrit\\python.exe scripts/build_api.py",
    "build:electron": "npm run build && npx electron-builder --win",
    "build:dist": "npm run build:api && npm run build:electron"
  },
  "dependencies": {
    "@indic-transliteration/sanscript": "^1.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.7",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.sanskrit.lookup",
    "productName": "Sanskrit Lookup",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "removePackageScripts": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist_python/api_server",
        "to": "api_server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
